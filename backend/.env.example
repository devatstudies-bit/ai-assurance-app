# Copy to .env and adjust. All settings use the ASSURANCE_ prefix.
ASSURANCE_DATABASE_URL=sqlite:///./assurance.db
# ASSURANCE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/assurance
ASSURANCE_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
ASSURANCE_SEED_ON_STARTUP=true

# Judge and attack models are configured in the app (AI models page / /api/models).
# Each model names the environment variable that holds its key; set those here or in Key Vault-backed settings:
# AZURE_OPENAI_JUDGE_KEY=...
# ANTHROPIC_API_KEY=...
ASSURANCE_SIMULATED_SCAN_SECONDS=6
ASSURANCE_SIMULATED_EVAL_SECONDS=4
ASSURANCE_AZURE_ATTACK_OBJECTIVES=10
ASSURANCE_LLM_MAX_WORKERS=4
ASSURANCE_LLM_TIMEOUT_SECONDS=120
ASSURANCE_LIBRARY_DIR=./library

# Development only: lets the web client pick a role with the X-Role header. Set false behind Entra ID.
ASSURANCE_ALLOW_ROLE_HEADER=true
